# The backend refuses to start until both values below are set.

# One entry per account, comma-separated: login:salt:hash
# Generate an entry with:
#   docker compose run --rm --no-deps backend python hash_password.py you@example.com
AUTH_USERS=

# Random signing key, at least 32 characters. Generate one with:
#   openssl rand -hex 32
AUTH_TOKEN_SECRET=

# Session lifetime in seconds (default: 8 hours)
AUTH_TOKEN_TTL_SECONDS=28800

# Only if the frontend is served from another origin (VITE_API_URL), comma-separated:
# CORS_ORIGINS=https://converter.example.com